package com.yourteam.dataprocessing

import org.junit.Test
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import kotlin.random.Random

class TemperatureTest {

    private val engine = TemperatureEngine()
    private val formatter = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US)

    @Test
    fun printSimulatedTemperatureStream() {
        var currentTime = System.currentTimeMillis()

        val sampleData = listOf(
            37.0, 36.8, 36.5, 36.4, 36.2,
            36.0, 35.9, 35.5, 35.0, 34.8,
            36.6, 37.1
        )

        sampleData.forEachIndexed { index, temp ->
            val reading = TemperatureReading(
                epochMillis = currentTime,
                temperatureC = temp
            )

            val out = engine.update(reading)

            val ts = formatter.format(Date(currentTime))
            val line = "${index + 1}. ts=$ts tempC=$temp risk=${out.ui.risk} mlEvent=${out.mlEvent != null}"

            System.out.println(line)

            currentTime += Random.nextLong(3000, 8000)
        }
    }
}

    private fun printScenario(title: String, raw: RawMultiLocationData) {
        println("")
        println("============================================================")
        println(title)
        println("============================================================")
        println("RAW INPUT:")
        raw.readings.forEachIndexed { index, reading ->
            println(
                "${index + 1}. " +
                        "location=${reading.location}, " +
                        "HR=${reading.heartRateBpm}, " +
                        "SpO2=${reading.spo2}, " +
                        "Temp=${reading.temperatureC}, " +
                        "Motion=${reading.motion}, " +
                        "Fall=${reading.fallDistanceFeet}"
            )
        }

        val result = processor.process(raw)

        println("")
        println("PROCESSED OUTPUT:")
        println("HR UI: ${result.hr?.ui}")
        println("HR Event: ${result.hr?.mlEvent}")

        println("SpO2:")
        println("  Value: ${result.spo2?.ui?.spo2}")
        println("  Baseline: ${result.spo2?.ui?.baselineSpo2}")
        println("  Drop: ${result.spo2?.ui?.spo2PctDropPercent}%")
        println("  Risk: ${result.spo2?.ui?.risk}")

        println("Temperature:")
        println("  Value: ${result.temperature?.ui?.temperatureC}")
        println("  Baseline: ${result.temperature?.ui?.baselineTemperatureC}")
        println("  Drop: ${result.temperature?.ui?.temperaturePctDropPercent}%")
        println("  Risk: ${result.temperature?.ui?.risk}")

        println("Fall UI: ${result.fall?.ui}")
        println("Fall Event: ${result.fall?.mlEvent}")

        println("")
        println("SENSOR HEALTH / ALERTS:")
        println("Rejected HR Sensors: ${result.rejectedHrSensors}")
        println("Rejected Temperature Sensors: ${result.rejectedTemperatureSensors}")
        println("Monitor Alerts: ${result.monitorAlerts}")

        println("")
        println("UI-FRIENDLY ALERTS:")
        if (result.rejectedHrSensors.isNotEmpty()) {
            println("Check HR sensor(s): ${result.rejectedHrSensors.joinToString()}")
        }
        if (result.rejectedTemperatureSensors.isNotEmpty()) {
            println("Check temperature sensor(s): ${result.rejectedTemperatureSensors.joinToString()}")
        }
        if (result.monitorAlerts.isNotEmpty()) {
            result.monitorAlerts.forEach { println(it) }
        }
        if (result.rejectedHrSensors.isEmpty() &&
            result.rejectedTemperatureSensors.isEmpty() &&
            result.monitorAlerts.isEmpty()
        ) {
            println("No sensor-quality alerts.")
        }

        println("")
    }
}
